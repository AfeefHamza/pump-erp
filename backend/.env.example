# Django configuration
DJANGO_SECRET_KEY=django-insecure-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database configuration (PostgreSQL)
DB_NAME=pump_erp
DB_USER=pump_user
DB_PASSWORD=pump_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Frontend integration and password recovery
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Session and Cookie security (Set to True in HTTPS production)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# CORS & CSRF Trusted Origins (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email configurations (console backend outputs emails to dev terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@pump-erp.com

